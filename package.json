{
  "name": "helia-vite",
  "version": "0.0.0",
  "description": "Using Helia with vite",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf ./dist",
    "dev": "vite",
    "start": "vite",
    "tag": "tsx scripts/tag.ts",
    "build": "vite build",
    "build:car": "npm run build && ipfs-car pack ./dist --output ./dist.car",
    "publish": "npm run build:car && tsx scripts/publish.ts",
    "preview": "vite preview",
    "test": "npm run build && test-browser-example test"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@helia/libp2p": "^1.0.7",
    "@helia/unixfs": "^7.2.1",
    "@libp2p/circuit-relay-v2": "^4.2.10",
    "@libp2p/floodsub": "^11.0.27",
    "@libp2p/gossipsub": "^15.0.23",
    "@libp2p/identify": "^4.1.11",
    "@libp2p/webrtc": "^6.0.28",
    "@libp2p/websockets": "^10.1.18",
    "@libp2p/webtransport": "^6.0.34",
    "blockstore-idb": "^4.0.1",
    "datastore-idb": "^5.0.1",
    "helia": "^6.1.2",
    "js-sha3": "^0.12.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "rimraf": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.31.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "ipfs-car": "^3.1.0",
    "qrcode-terminal": "^0.12.0",
    "test-ipfs-example": "^1.3.3",
    "tsx": "^4.20.5",
    "vite": "^8.0.8"
  }
}
